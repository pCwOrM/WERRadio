<VirtualHost 127.0.0.1:8088>
    ServerName rad.werr.io
    DocumentRoot /var/www/rad.werr.io

    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    ProxyPreserveHost On
    ProxyPass /stream http://127.0.0.1:8000/stream
    ProxyPassReverse /stream http://127.0.0.1:8000/stream
    ProxyPass /status-json.xsl http://127.0.0.1:8000/status-json.xsl
    ProxyPassReverse /status-json.xsl http://127.0.0.1:8000/status-json.xsl

    <Directory /var/www/rad.werr.io>
        Options -Indexes
        AllowOverride None
        Require all granted
    </Directory>

    ErrorLog ${APACHE_LOG_DIR}/rad.werr.io-error.log
    CustomLog ${APACHE_LOG_DIR}/rad.werr.io-access.log combined
</VirtualHost>
